# Пример переменных окружения. Скопируйте этот файл в .env и впишите свои значения.
# Файл .env в репозиторий НЕ коммитится (см. .gitignore).

# --- Для локального запуска (./gradlew bootRun) ---
DB_URL=jdbc:mysql://localhost:3306/mydb?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=ваш_пароль_здесь

# --- Для запуска через docker compose ---
MYSQL_ROOT_PASSWORD=ваш_root_пароль
MYSQL_DATABASE=mydb
MYSQL_USER=user
MYSQL_PASSWORD=ваш_пароль_пользователя
